[sub_resource type="GDScript" id="GDScript_257lx"]
script/source = "@tool
extends ScrollContainerCSS
@onready var Page: ControlCSS = %Page
@onready var WelcomeTxt: LabelCSS = %WelcomeTxt
@onready var DateTxt: LabelCSS = %DateTxt
@onready var SalesTxt: LabelCSS = %SalesTxt
@onready var InvoicesTxt: LabelCSS = %InvoicesTxt
@onready var ProductsTxt: LabelCSS = %ProductsTxt
@onready var LoadingCircle: TextureRectCSS = %LoadingCircle
@onready var LoadingCircleAnim: AnimationPlayer = %LoadingCircleAnim
@onready var ErrorTxt: LabelCSS = %ErrorTxt

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	super._ready()
	Page.visible = false
	LoadingCircle.visible = true
	LoadingCircleAnim.play(\"rotate\")

	# Cargamos las ventas
	var response: Dictionary = await BackendClient.get_ventas()
	if not response.ok:
		_show_error(response)
		return

	var sales: Array = response.data
	_load_sales_today(sales)

	# Cargamos los productos
	response = await BackendClient.get_productos()
	if not response.ok:
		_show_error(response)
		return

	var products: Array = response.data

	WelcomeTxt.text = \"¡Bienvenido %s!\" % BackendClient.username
	DateTxt.text = _get_formatted_date()
	ProductsTxt.text = str(products.size())

	LoadingCircle.visible = false
	Page.visible = true

func _show_error(response: Dictionary):
	Page.visible = false
	LoadingCircle.visible = false
	ErrorTxt.visible = true
	if response.status == 0:
		ErrorTxt.text = \"%s: %d\" % [\"Sin respuesta\", 503]
	else:
		var error_message = response.data.get(\"error\", \"\")
		if error_message == \"\":
			error_message = response.data.get(\"detail\", \"\")
		if error_message == \"\":
			error_message = response.data.get(\"message\", \"\")
		if error_message == \"\":
			error_message = \"Error desconocido\"
		ErrorTxt.text = \"%s: %d\" % [str(error_message), response.status]

func _get_formatted_date() -> String:
	var date := Time.get_date_dict_from_system()

	var months := [
		\"enero\",
		\"febrero\",
		\"marzo\",
		\"abril\",
		\"mayo\",
		\"junio\",
		\"julio\",
		\"agosto\",
		\"septiembre\",
		\"octubre\",
		\"noviembre\",
		\"diciembre\"
	]

	return \"%02d de %s de %d\" % [
		date.day,
		months[date.month - 1],
		date.year
	]


func _load_sales_today(sales: Array) -> void:
	# =================================
	# INICIO DEL DÍA
	# =================================

	var today := Time.get_date_dict_from_system()

	var start_of_day := {
		\"year\": today.year,
		\"month\": today.month,
		\"day\": today.day,
		\"hour\": 0,
		\"minute\": 0,
		\"second\": 0
	}

	var start_timestamp := (
		Time.get_unix_time_from_datetime_dict(
			start_of_day
		) * 1000
	)

	# =================================
	# FIN DEL DÍA
	# =================================

	var end_of_day := start_of_day.duplicate()
	end_of_day.hour = 23
	end_of_day.minute = 59
	end_of_day.second = 59

	var end_timestamp := (
		Time.get_unix_time_from_datetime_dict(
			end_of_day
		) * 1000 + 999
	)

	# =================================
	# FILTRAR VENTAS DE HOY
	# =================================

	var today_sales: Array = sales.filter(
		func(sale: Dictionary) -> bool:
			var sale_date = sale.get(\"date\", 0)

			return (
				int(sale_date) >= start_timestamp
				and int(sale_date) <= end_timestamp
			)
	)

	# =================================
	# TOTAL VENDIDO
	# =================================

	var total := 0.0

	for sale in today_sales:
		total += float(sale.get(\"total\", 0))

	# =================================
	# CANTIDAD DE FACTURAS
	# =================================

	var invoice_count := today_sales.size()

	# =================================
	# MOSTRAR
	# =================================

	SalesTxt.text = \"$ %.0f\" % total
	InvoicesTxt.text = str(invoice_count)
"

