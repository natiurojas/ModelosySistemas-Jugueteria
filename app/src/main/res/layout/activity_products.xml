<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF8"
    android:id="@+id/main"
    tools:context=".ProductsActivity">


    <!-- ====================================== -->
    <!-- CONTENEDOR PRINCIPAL                   -->
    <!-- ====================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/productsCard"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_margin="16dp"

        app:cardBackgroundColor="#FFFCF3"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- ================================= -->
            <!-- TÍTULO                            -->
            <!-- ================================= -->

            <TextView
                android:id="@+id/txtProductsTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="25dp"
                android:layout_marginTop="25dp"

                android:text="Productos"
                android:textColor="#27344A"
                android:textSize="22sp"
                android:textStyle="bold"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- ================================= -->
            <!-- BOTÓN NUEVO PRODUCTO               -->
            <!-- ================================= -->

            <Button
                android:id="@+id/btnNewProduct"

                android:layout_width="150dp"
                android:layout_height="48dp"

                android:layout_marginEnd="25dp"
                android:layout_marginTop="20dp"

                android:text="+  Nuevo producto"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"

                android:background="@drawable/button_new_product"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- ================================= -->
            <!-- BUSCADOR                           -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/searchContainer"

                android:layout_width="290dp"
                android:layout_height="48dp"

                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:paddingStart="12dp"
                android:paddingEnd="12dp"

                android:background="@drawable/search_background"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtProductsTitle">


                <EditText
                    android:id="@+id/edtSearch"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:layout_marginStart="8dp"

                    android:background="@android:color/transparent"

                    android:hint="Buscar producto..."
                    android:textColor="#27344A"
                    android:textColorHint="#A5A5A5"
                    android:textSize="14sp"

                    android:singleLine="true" />


                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"

                    android:src="@drawable/ic_search"
                    android:contentDescription="@null" />

            </LinearLayout>


            <!-- ================================= -->
            <!-- CABECERA DE TABLA                 -->
            <!-- ================================= -->

            <LinearLayout
                android:id="@+id/tableHeader"

                android:layout_width="348dp"
                android:layout_height="49dp"

                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="25dp"

                android:background="@drawable/table_header_background"
                android:gravity="center_vertical"

                android:orientation="horizontal"
                android:paddingStart="8dp"

                android:paddingEnd="8dp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/searchContainer">


                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="Imagen"
                    android:textColor="#27344A"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nombre"
                    android:textColor="#27344A"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:text="Categoría"
                    android:textColor="#27344A"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:text="Precio"
                    android:textColor="#27344A"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Stock"
                    android:textColor="#27344A"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="Acciones"
                    android:textColor="#27344A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================= -->
            <!-- RECYCLERVIEW                       -->
            <!-- ================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProducts"

                android:layout_width="346dp"
                android:layout_height="390dp"

                android:layout_marginEnd="25dp"

                android:clipToPadding="false"

                android:overScrollMode="never"
                android:paddingTop="3dp"

                android:paddingBottom="5dp"

                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

                app:layout_constraintEnd_toEndOf="@+id/tableHeader"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/tableHeader"

                app:layout_constraintTop_toBottomOf="@id/tableHeader"
                tools:listitem="@layout/item_product" />

            <LinearLayout
                android:id="@+id/bottomNavigation"

                android:layout_width="0dp"
                android:layout_height="75dp"

                android:background="#FFFDF8"
                android:elevation="8dp"

                android:gravity="center_vertical"

                android:orientation="horizontal"

                android:paddingStart="8dp"
                android:paddingEnd="8dp"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">


                <!-- INICIO -->

                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:clickable="true"
                    android:focusable="true"

                    android:gravity="center"
                    android:orientation="vertical">


                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"

                        android:contentDescription="Inicio"
                        android:src="@drawable/ic_home" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Inicio"
                        android:textColor="#27344A"
                        android:textSize="11sp" />

                </LinearLayout>


                <!-- VENTAS -->

                <LinearLayout
                    android:id="@+id/navSales"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:clickable="true"
                    android:focusable="true"

                    android:gravity="center"
                    android:orientation="vertical">


                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"

                        android:contentDescription="Ventas"
                        android:src="@drawable/ic_cart" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Ventas"
                        android:textColor="#27344A"
                        android:textSize="11sp" />

                </LinearLayout>


                <!-- BOTÓN + -->

                <LinearLayout
                    android:id="@+id/navAdd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:gravity="center">


                    <ImageButton
                        android:id="@+id/btnAdd"
                        android:layout_width="58dp"
                        android:layout_height="58dp"

                        android:background="@drawable/add_button"
                        android:contentDescription="Agregar"

                        android:padding="15dp"
                        android:src="@drawable/ic_add" />

                </LinearLayout>


                <!-- PRODUCTOS -->

                <LinearLayout
                    android:id="@+id/navProducts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:clickable="true"
                    android:focusable="true"

                    android:gravity="center"
                    android:orientation="vertical">


                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"

                        android:contentDescription="Productos"
                        android:src="@drawable/ic_products" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Productos"
                        android:textColor="#27344A"
                        android:textSize="11sp" />

                </LinearLayout>


                <!-- MÁS -->

                <LinearLayout
                    android:id="@+id/navInvoice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:clickable="true"
                    android:focusable="true"

                    android:gravity="center"
                    android:orientation="vertical">


                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"

                        android:contentDescription="Más"
                        android:src="@drawable/ic_document" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Facturas"
                        android:textColor="#27344A"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================= -->
            <!-- PAGINACIÓN                         -->
            <!-- ================================= -->

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>