<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF8"

    tools:context=".AddEditProductActivity">


    <!-- ====================================== -->
    <!-- BARRA SUPERIOR                         -->
    <!-- ====================================== -->

    <LinearLayout
        android:id="@+id/topBar"

        android:layout_width="0dp"
        android:layout_height="62dp"

        android:background="@drawable/topbar_background"
        android:gravity="center_vertical"

        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="42dp"
            android:layout_height="42dp"

            android:background="@android:color/transparent"

            android:contentDescription="Volver"
            android:padding="7dp"

            android:src="@drawable/ic_arrow_back" />


        <TextView
            android:id="@+id/txtTitle"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"

            android:text="Nuevo producto"
            android:textColor="#27344A"
            android:textSize="19sp"
            android:textStyle="bold" />


        <View
            android:layout_width="42dp"
            android:layout_height="42dp" />

    </LinearLayout>


    <!-- ====================================== -->
    <!-- CONTENIDO                              -->
    <!-- ====================================== -->

    <ScrollView
        android:id="@+id/scrollContent"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"

        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="24dp">


            <!-- ================================= -->
            <!-- TÍTULO                             -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Información del producto"
                android:textColor="#27344A"
                android:textSize="21sp"
                android:textStyle="bold" />


            <!-- ================================= -->
            <!-- NOMBRE                             -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:text="Nombre"
                android:textColor="#27344A"
                android:textSize="14sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/edtName"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginTop="8dp"

                android:background="@drawable/search_background"

                android:hint="Nombre del producto"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"

                android:singleLine="true"

                android:textColor="#27344A"
                android:textColorHint="#A5A5A5"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- DESCRIPCIÓN                        -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:text="Descripción"
                android:textColor="#27344A"
                android:textSize="14sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/edtDescription"

                android:layout_width="match_parent"
                android:layout_height="90dp"

                android:layout_marginTop="8dp"

                android:background="@drawable/search_background"

                android:gravity="top"

                android:hint="Descripción del producto"
                android:inputType="textMultiLine"

                android:padding="14dp"

                android:textColor="#27344A"
                android:textColorHint="#A5A5A5"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- CATEGORÍA                          -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:text="Categoría"
                android:textColor="#27344A"
                android:textSize="14sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/edtCategory"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginTop="8dp"

                android:background="@drawable/search_background"

                android:hint="Ej: Muñecos, Juegos, Peluches..."

                android:paddingStart="14dp"
                android:paddingEnd="14dp"

                android:singleLine="true"

                android:textColor="#27344A"
                android:textColorHint="#A5A5A5"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- PRECIO                             -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:text="Precio"
                android:textColor="#27344A"
                android:textSize="14sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/edtPrice"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginTop="8dp"

                android:background="@drawable/search_background"

                android:hint="$ 0"

                android:inputType="numberDecimal"

                android:paddingStart="14dp"
                android:paddingEnd="14dp"

                android:singleLine="true"

                android:textColor="#27344A"
                android:textColorHint="#A5A5A5"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- STOCK                              -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:text="Stock"
                android:textColor="#27344A"
                android:textSize="14sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/edtStock"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginTop="8dp"

                android:background="@drawable/search_background"

                android:hint="Cantidad disponible"

                android:inputType="number"

                android:paddingStart="14dp"
                android:paddingEnd="14dp"

                android:singleLine="true"

                android:textColor="#27344A"
                android:textColorHint="#A5A5A5"
                android:textSize="14sp" />


            <!-- ================================= -->
            <!-- BOTÓN GUARDAR                     -->
            <!-- ================================= -->

            <Button
                android:id="@+id/btnSave"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="30dp"
                android:layout_marginBottom="25dp"

                android:background="@drawable/button_new_product"

                android:text="Guardar producto"

                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>