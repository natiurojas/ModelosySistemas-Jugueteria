<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFDF8">
 <LinearLayout android:id="@+id/settingsTopBar" android:layout_width="0dp" android:layout_height="62dp" android:background="@drawable/topbar_background" android:gravity="center_vertical" android:paddingHorizontal="15dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <ImageButton android:id="@+id/btnManagerSettingsBack" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:contentDescription="Volver" android:padding="7dp" android:src="@drawable/ic_arrow_back"/>
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Configuración del negocio" android:textColor="#27344A" android:textSize="18sp" android:textStyle="bold"/>
  <View android:layout_width="42dp" android:layout_height="42dp"/>
 </LinearLayout>
 <TextView android:id="@+id/txtManagerSettingsDescription" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="20dp" android:text="Seleccioná una sucursal para modificar la hora límite de ventas o configurar la apertura y el cierre de sus cajas." android:textColor="#657084" android:textSize="15sp" app:layout_constraintTop_toBottomOf="@id/settingsTopBar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <Button android:id="@+id/btnLoadManagerSettings" android:layout_width="0dp" android:layout_height="50dp" android:layout_margin="20dp" android:background="@drawable/button_new_product" android:text="Cargar configuración" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/txtManagerSettingsDescription" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
