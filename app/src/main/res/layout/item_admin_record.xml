<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="#FFFCF3" app:cardCornerRadius="12dp" app:cardElevation="2dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
   <TextView android:id="@+id/txtRecordTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#27344A" android:textSize="16sp" android:textStyle="bold"/>
   <TextView android:id="@+id/txtRecordSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#657084" android:textSize="13sp"/>
   <TextView android:id="@+id/txtRecordExtra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#657084" android:textSize="13sp"/>
  </LinearLayout>
  <ImageButton android:id="@+id/btnEditRecord" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="Editar" android:padding="8dp" android:src="@drawable/ic_edit"/>
  <ImageButton android:id="@+id/btnDeleteRecord" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="Eliminar" android:padding="8dp" android:src="@drawable/ic_delete"/>
 </LinearLayout>
</androidx.cardview.widget.CardView>
