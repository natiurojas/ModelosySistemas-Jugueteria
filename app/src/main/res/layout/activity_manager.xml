<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#FFFDF8">
    <LinearLayout android:id="@+id/topBar" android:layout_width="0dp" android:layout_height="62dp"
        android:background="@drawable/topbar_background" android:gravity="center_vertical" android:paddingHorizontal="15dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageButton android:id="@+id/btnManagerBack" android:layout_width="42dp" android:layout_height="42dp"
            android:background="@android:color/transparent" android:contentDescription="Volver" android:padding="7dp" android:src="@drawable/ic_arrow_back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Panel del gerente" android:textColor="#27344A" android:textSize="20sp" android:textStyle="bold"/>
        <View android:layout_width="42dp" android:layout_height="42dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seguimiento del negocio" android:textColor="#27344A" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Seleccioná una sección para administrar y consultar el local." android:textColor="#657084" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Configuración" android:textColor="#27344A" android:textSize="17sp" android:textStyle="bold"/>
            <Button android:id="@+id/btnManagerHours" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/button_new_product" android:text="Horarios de cajas y límite de ventas" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Consultas e informes" android:textColor="#27344A" android:textSize="17sp" android:textStyle="bold"/>
            <Button android:id="@+id/btnManagerStock" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/button_new_product" android:text="Consultar stock de productos" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
            <Button android:id="@+id/btnManagerCashHistory" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/button_new_product" android:text="Histórico de ventas de caja" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
            <Button android:id="@+id/btnManagerProductHistory" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/button_new_product" android:text="Histórico de venta de productos" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
            <Button android:id="@+id/btnManagerRevenue" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/button_new_product" android:text="Recaudación de un día" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
            <Button android:id="@+id/btnManagerProfit" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/button_new_product" android:text="Ganancia del día" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
