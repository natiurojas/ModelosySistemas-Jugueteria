<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="9dp" app:cardBackgroundColor="#FFFCF3" app:cardCornerRadius="12dp" app:cardElevation="2dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
  <TextView android:id="@+id/txtRecordTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registro" android:textColor="#27344A" android:textSize="16sp" android:textStyle="bold"/>
  <TextView android:id="@+id/txtRecordSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Detalle" android:textColor="#657084" android:textSize="13sp"/>
  <TextView android:id="@+id/txtRecordAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="$ 0" android:textColor="#27344A" android:textSize="15sp" android:textStyle="bold"/>
 </LinearLayout>
</androidx.cardview.widget.CardView>
