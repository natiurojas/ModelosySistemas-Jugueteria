<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="70dp"

    android:orientation="horizontal"
    android:gravity="center_vertical"

    android:paddingStart="8dp"
    android:paddingEnd="8dp"

    android:background="@drawable/product_row_background">


    <!-- ================================= -->
    <!-- IMAGEN                            -->
    <!-- ================================= -->

    <ImageView
        android:id="@+id/imgProduct"

        android:layout_width="65dp"
        android:layout_height="60dp"

        android:padding="5dp"

        android:scaleType="centerInside"

        android:contentDescription="Imagen del producto" />


    <!-- ================================= -->
    <!-- NOMBRE                            -->
    <!-- ================================= -->

    <TextView
        android:id="@+id/txtProductName"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1.5"

        android:paddingEnd="5dp"

        android:text="Osito de Peluche"
        android:textColor="#27344A"
        android:textSize="13sp"
        android:textStyle="bold" />


    <!-- ================================= -->
    <!-- CATEGORÍA                         -->
    <!-- ================================= -->

    <TextView
        android:id="@+id/txtCategory"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1.1"

        android:text="Peluches"
        android:textColor="#27344A"
        android:textSize="13sp" />


    <!-- ================================= -->
    <!-- PRECIO                            -->
    <!-- ================================= -->

    <TextView
        android:id="@+id/txtPrice"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="0.9"

        android:text="$ 5.400"
        android:textColor="#27344A"
        android:textSize="13sp"
        android:textStyle="bold" />


    <!-- ================================= -->
    <!-- STOCK                             -->
    <!-- ================================= -->

    <TextView
        android:id="@+id/txtStock"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="0.6"

        android:text="25"
        android:textColor="#27344A"
        android:textSize="13sp" />


    <!-- ================================= -->
    <!-- ACCIONES                          -->
    <!-- ================================= -->

    <LinearLayout
        android:id="@+id/actionsContainer"

        android:layout_width="90dp"
        android:layout_height="match_parent"

        android:orientation="horizontal"
        android:gravity="center_vertical">


        <!-- Ver -->
        <ImageButton
            android:id="@+id/btnView"

            android:layout_width="30dp"
            android:layout_height="40dp"

            android:background="@android:color/transparent"

            android:contentDescription="Ver producto"

            android:padding="6dp"
            android:src="@drawable/ic_visibility"
            android:visibility="gone" />


        <!-- Editar -->
        <ImageButton
            android:id="@+id/btnEdit"

            android:layout_width="30dp"
            android:layout_height="40dp"

            android:background="@android:color/transparent"

            android:src="@drawable/ic_edit"

            android:contentDescription="Editar producto"
            android:padding="6dp" />


        <!-- Eliminar -->
        <ImageButton
            android:id="@+id/btnDelete"

            android:layout_width="30dp"
            android:layout_height="40dp"

            android:background="@android:color/transparent"

            android:src="@drawable/ic_delete"

            android:contentDescription="Eliminar producto"
            android:padding="6dp" />

    </LinearLayout>

</LinearLayout>