<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#FFFDF8"
    android:id="@+id/main"
    tools:context=".InvoiceDetailActivity">


    <!-- ====================================== -->
    <!-- BARRA SUPERIOR                         -->
    <!-- ====================================== -->

    <LinearLayout
        android:id="@+id/topBar"

        android:layout_width="0dp"
        android:layout_height="60dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"

        android:background="@drawable/topbar_background"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="42dp"
            android:layout_height="42dp"

            android:background="@android:color/transparent"

            android:src="@drawable/ic_arrow_back"

            android:padding="7dp"

            android:contentDescription="Volver" />


        <TextView
            android:id="@+id/txtTitle"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"

            android:text="Factura"

            android:textColor="#27344A"
            android:textSize="18sp"
            android:textStyle="bold" />


        <ImageButton
            android:id="@+id/user"

            android:layout_width="42dp"
            android:layout_height="42dp"

            android:background="@android:color/transparent"

            android:contentDescription="Compartir factura"

            android:padding="8dp"

            android:src="@drawable/ic_user" />

    </LinearLayout>


    <!-- ====================================== -->
    <!-- CONTENIDO                              -->
    <!-- ====================================== -->

    <ScrollView
        android:id="@+id/scrollView"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"

        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="25dp">


            <!-- ================================= -->
            <!-- CABECERA DE FACTURA                -->
            <!-- ================================= -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="#FFFCF3"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">


                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="20dp">


                    <TextView
                        android:id="@+id/txtInvoiceNumber"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Factura #0001"

                        android:textColor="#27344A"
                        android:textSize="22sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/txtDate"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="17/09/2026 11:30"

                        android:textColor="#777777"
                        android:textSize="12sp" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="17dp"
                        android:layout_marginBottom="15dp"

                        android:background="#E6E1D8" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Cliente"

                        android:textColor="#888888"
                        android:textSize="11sp" />


                    <TextView
                        android:id="@+id/txtClient"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="Juan Pérez"

                        android:textColor="#27344A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================= -->
            <!-- PRODUCTOS                         -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"

                android:text="Productos"

                android:textColor="#27344A"
                android:textSize="16sp"
                android:textStyle="bold" />


            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                app:cardBackgroundColor="#FFFCF3"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerInvoiceItems"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:nestedScrollingEnabled="false"

                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"

                    tools:listitem="@layout/item_invoice_detail" />

            </androidx.cardview.widget.CardView>


            <!-- ================================= -->
            <!-- TOTAL                              -->
            <!-- ================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="70dp"

                android:layout_marginTop="15dp"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:paddingStart="18dp"
                android:paddingEnd="18dp"

                android:background="#FFF5D9">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="TOTAL"

                    android:textColor="#27344A"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtTotal"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="$ 15.200"

                    android:textColor="#27344A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================= -->
            <!-- BOTÓN COMPARTIR                   -->
            <!-- ================================= -->

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>