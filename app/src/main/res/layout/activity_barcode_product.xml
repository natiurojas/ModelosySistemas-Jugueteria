<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF9EC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buscar producto por código de barras" android:textSize="22sp" android:textStyle="bold" android:textColor="#27344A" />
  <EditText android:id="@+id/edtBarcode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="Código de barras" android:inputType="number" android:singleLine="true" />
  <Button android:id="@+id/btnFindBarcode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buscar producto" />
  <TextView android:id="@+id/txtBarcodeResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="El producto encontrado aparecerá aquí." android:textSize="17sp" android:textColor="#27344A" />
  <Button android:id="@+id/btnBarcodeBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Volver" />
 </LinearLayout>
</ScrollView>
