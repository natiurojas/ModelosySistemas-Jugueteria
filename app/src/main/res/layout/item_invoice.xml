<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="105dp"

    android:layout_marginBottom="10dp"

    app:cardBackgroundColor="#FFFCF3"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:paddingStart="18dp"
        android:paddingEnd="10dp">


        <!-- ================================= -->
        <!-- INFORMACIÓN                       -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical">


            <TextView
                android:id="@+id/txtInvoiceNumber"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Factura #0001"

                android:textColor="#27344A"
                android:textSize="15sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtClient"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:text="Cliente: Juan Pérez"

                android:textColor="#555555"
                android:textSize="12sp" />


            <TextView
                android:id="@+id/txtDate"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="20/05/2024 15:30"

                android:textColor="#888888"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ================================= -->
        <!-- TOTAL                              -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:gravity="center">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Total"

                android:textColor="#777777"
                android:textSize="11sp" />


            <TextView
                android:id="@+id/txtTotal"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="$ 18.300"

                android:textColor="#27344A"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================= -->
        <!-- VER                                -->
        <!-- ================================= -->

        <ImageButton
            android:id="@+id/btnView"

            android:layout_width="40dp"
            android:layout_height="45dp"

            android:background="@android:color/transparent"

            android:src="@drawable/ic_visibility"

            android:padding="8dp"

            android:contentDescription="Ver factura" />

    </LinearLayout>

</androidx.cardview.widget.CardView>